Source: porto
Maintainer: Porto Team <porto@yandex-team.ru>
Build-Depends:
 cmake, automake, debhelper (>= 10),
 pkg-config, autoconf, libtool,
 protobuf-compiler,
 g++ (>= 4:5),
 dh-python,
 python3-setuptools,
 bash-completion, pandoc
Build-Depends-Arch:
 libprotobuf-dev, libncurses5-dev,
 libnl-3-dev (>=3.5),
 libnl-genl-3-dev (>=3.5),
 libnl-route-3-dev (>=3.5),
 libnl-idiag-3-dev (>=3.5),
 libelf-dev, zlib1g-dev, libzstd-dev,
 libbpf-dev (>= 1.2.2), libssl-dev,
 libc6-dev, linux-libc-dev (>= 5.15),
 libgoogle-perftools-dev (>= 2.4),
 libseccomp-dev
Standards-Version: 3.9.2
X-Python3-Version: >= 3.2
Homepage: https://github.com/ten-nancy/porto
Vcs-Git: https://github.com/ten-nancy/porto.git

Package: pkgprefixporto
Section: utils
Priority: extra
Architecture: amd64
Depends: ${shlibs:Depends}, ${misc:Depends}, logrotate
Recommends: bash-completion
Suggests: linux-image (>=5.15), tar, xz-utils, pigz, pixz, e2fsprogs,
 squashfs-tools (>=1:4.3), lvm2, thin-provisioning-tools,
Description: Porto - linux container management system
 Requires Linux kernel version >= 5.15
 .
 Some features requires special kernel.

Package: python3-portopy
Section: python
Priority: optional
Architecture: all
Depends: python3-protobuf, ${python3:Depends}
Description: Python 3 API for porto

Package: pkgprefixporto-tests
Section: utils
Priority: extra
Architecture: amd64
Depends:
  ${shlibs:Depends}, ${misc:Depends}, pkgprefixporto (= ${binary:Version}), python3, sudo,
  attr, fio, iperf3, stress, nbd-server, procps, squashfs-tools,
  python3-protobuf, cmake, lz4
Description: Porto test suite
 Porto source tree with built tests and CTest files in /opt/porto-tests,
 used by infra/porto/tests. Not intended for production hosts.
