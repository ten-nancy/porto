#!/usr/bin/make -f

PKGPREFIX?=
DESTDIR=$(CURDIR)/debian/$(PKGPREFIX)porto
# not under /usr: porto wants write access for binds from system paths, see IsSystemPath()
TESTSDIR=/opt/porto-tests
SBINDIR=$(DESTDIR)/usr/sbin
BUILD_TYPE?=Release
PORTO_INSTALL_ADDON?=

# fixed name for debian/porto-tests.install.in; not "build", that shadows the target
PORTO_BUILDDIR=obj

sedpkgprefix:=sed -e "s/PKGPREFIX/$(PKGPREFIX)/gI"

export DH_VERBOSE=1
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto

override_dh_auto_configure:
	rm -f debian/control
	$(sedpkgprefix) debian/control.in               > debian/control
	$(sedpkgprefix) debian/porto.bash-completion.in > debian/$(PKGPREFIX)porto.bash-completion
	$(sedpkgprefix) debian/porto.cron.d.in          > debian/$(PKGPREFIX)porto.cron.d
	$(sedpkgprefix) debian/porto.dirs.in            > debian/$(PKGPREFIX)porto.dirs
	$(sedpkgprefix) debian/porto.docs.in            > debian/$(PKGPREFIX)porto.docs
	$(sedpkgprefix) debian/porto.init.in            > debian/$(PKGPREFIX)porto.init
	$(sedpkgprefix) debian/porto.install.in         > debian/$(PKGPREFIX)porto.install
	$(sedpkgprefix) debian/porto-tests.install.in   > debian/$(PKGPREFIX)porto-tests.install
	$(sedpkgprefix) debian/porto.logrotate.in       > debian/$(PKGPREFIX)porto.logrotate
	$(sedpkgprefix) debian/porto.postinst.in        > debian/$(PKGPREFIX)porto.postinst
	$(sedpkgprefix) debian/porto.service.in         > debian/$(PKGPREFIX)porto.service
	$(sedpkgprefix) debian/porto.upstart.in         > debian/$(PKGPREFIX)porto.upstart

	dh_auto_configure -- -DCMAKE_BUILD_TYPE=$(BUILD_TYPE)

override_dh_strip:
	dh_strip -N$(PKGPREFIX)porto-tests
	dh_strip -p$(PKGPREFIX)porto-tests --no-automatic-dbgsym

override_dh_installinit:
	dh_installinit --no-restart-on-upgrade

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_install:
	dh_install
	# CTest files use absolute build paths
	sed -i 's|$(CURDIR)|$(TESTSDIR)|g' \
		debian/$(PKGPREFIX)porto-tests$(TESTSDIR)/$(PORTO_BUILDDIR)/CTestTestfile.cmake \
		debian/$(PKGPREFIX)porto-tests$(TESTSDIR)/$(PORTO_BUILDDIR)/test/CTestTestfile.cmake
	$(PORTO_INSTALL_ADDON)
	dh_bash-completion
	$(SBINDIR)/portoctl --help

override_dh_auto_test:

%:
	dh $@ --with python3 --without python-support --parallel --builddir=$(PORTO_BUILDDIR)
